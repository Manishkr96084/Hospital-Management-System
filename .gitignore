# ==========================================
# Medivanta AI - Git Ignore Specification
# ==========================================

# 1. Environment & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.*.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# 2. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.oxlint_cache/

# 4. Databases & Local Data (Exclude real patient data / generated local DBs)
*.db
*.sqlite
*.sqlite3
medivanta.db
backend/medivanta.db

# 5. Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Operating System & Editor Settings
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Logs & Temporary Files
logs/
*.log
task-*.log
backend/logs/
*.bak
