# ==========================================
# MEDIVANTA AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Backend API Configuration
PROJECT_NAME="Medivanta AI Hospital Management"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for production or SQLite for local dev)
DATABASE_URL="sqlite:///./medivanta.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/medivanta_db"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379/0"

# AI Integration Keys (Optional: Intelligent fallback engine active)
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY=""

# Email & SMS Service Provider Credentials (Optional)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@medivanta.health"
SMTP_PASSWORD=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Hospital Details
HOSPITAL_NAME="Medivanta"
HOSPITAL_ADDRESS="108 Healthway Boulevard, Medical City, MC 94016"
HOSPITAL_PHONE="+1 (800) 555-MEDI"
HOSPITAL_EMAIL="concierge@medivanta.health"

# Frontend Environment Variables (in frontend/.env)
# VITE_API_BASE_URL="http://localhost:8000/api"
